---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { getPosts } from "../../lib/posts";

const posts = await getPosts();
const byYear = Map.groupBy(posts, (p) => p.data.date.getUTCFullYear());
---
<Base title="Posts" description="Every post on MuirSandwich, by year.">
  <h1>Posts</h1>
  {[...byYear].map(([year, list]) => (
    <section>
      <h2>{year}</h2>
      <PostList posts={list} />
    </section>
  ))}
</Base>
