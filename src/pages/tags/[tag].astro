---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { getPosts, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = new Set(posts.flatMap((p) => [...p.data.tags, ...(p.data.category ? [p.data.category.toLowerCase()] : [])]));
  return [...tags].map((tag) => ({
    params: { tag },
    props: {
      posts: posts.filter((p) => p.data.tags.includes(tag) || p.data.category?.toLowerCase() === tag),
    },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props as { posts: Post[] };
---
<Base title={`#${tag}`} description={`Posts tagged ${tag}.`}>
  <h1>#{tag}</h1>
  <PostList posts={posts} />
</Base>
