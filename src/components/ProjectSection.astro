---
import ProjectCard from "./ProjectCard.astro";
import type { Project } from "@/utils/projects";

type Props = {
  id: string;
  title: string;
  blurb: string;
  projects: Project[];
  link?: { label: string; url: string };
  limit?: number;
};
const { id, title, blurb, projects, link, limit } = Astro.props;
const shown = limit ? projects.slice(0, limit) : projects;
---

<section id={id} class="pt-10 pb-4">
  <h2 class="text-2xl font-semibold tracking-wide">{title}</h2>
  <p class="text-muted-foreground mt-1">{blurb}</p>
  <ul class="mt-6 grid gap-6 sm:grid-cols-2">
    {shown.map(project => <ProjectCard project={project} />)}
  </ul>
  {
    link && (
      <p class="mt-4">
        <a
          href={link.url}
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          rel="noopener"
        >
          {link.label} →
        </a>
      </p>
    )
  }
</section>
