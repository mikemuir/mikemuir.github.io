---
import { excerpt, formatDate, type Post } from "../lib/posts";

interface Props {
  posts: Post[];
  showExcerpt?: boolean;
}
const { posts, showExcerpt = false } = Astro.props;
---
<ul class="post-list">
  {posts.map((post) => (
    <li>
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <div>
        <a href={`/posts/${post.id}/`}>{post.data.title}</a>
        {showExcerpt && <p>{excerpt(post)}</p>}
      </div>
    </li>
  ))}
</ul>
